{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/funded-store run build",
  "outputDirectory": "artifacts/funded-store/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mutual-fund-emi-store--akankshasing128.replit.app/api/:path*"
    },
    {
      "source": "/products/:slug",
      "destination": "/index.html"
    }
  ]
}